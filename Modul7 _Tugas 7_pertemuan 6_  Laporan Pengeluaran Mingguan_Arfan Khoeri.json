      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Set rentang waktu 7 hari terakhir\nconst today = new Date();\ntoday.setHours(23, 59, 59, 999);\n\nconst sevenDaysAgo = new Date(today);\nsevenDaysAgo.setDate(today.getDate() - 7);\nsevenDaysAgo.setHours(0, 0, 0, 0);\n\nlet formattedString = \"Data pengeluaran saya 7 hari terakhir:\\n\\n\";\nlet hasExpenses = false;\n\nfor (const item of items) {\n  const json = item.json;\n  const rawDate = json['Tanggal'] || \"\"; // Sesuaikan nama kolom di Sheet\n  \n  // Parse tanggal format DD/MM/YYYY\n  const [day, month, year] = rawDate.split(\"/\").map(Number);\n  const expenseDate = new Date(year, month - 1, day);\n\n  if (expenseDate >= sevenDaysAgo && expenseDate <= today) {\n    hasExpenses = true;\n    formattedString += `${rawDate} | ${json['Kategori']}\\n`;\n    formattedString += `${json['Deskripsi']}\\n`;\n    formattedString += `Metode: ${json['Metode']} | Rp${json['Jumlah']}\\n\\n`;\n  }\n}\n\nreturn {\n  promptData: formattedString,\n  hasExpenses: hasExpenses\n};\n"
      },
